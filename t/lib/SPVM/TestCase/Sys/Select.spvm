class TestCase::Sys::Select {
  use Sys;
  use Sys::Select;
  use Sys::Select::Fd_set;
  use Sys::Select::Constant as SELECT;
  
  use Sys::Socket;
  use Sys::Socket::Constant as SOCKET;
  use Sys::Socket::Util;
  use Sys::Process;
  
  use Fn;
  
  static method select : int () {
    {
      # Pair 0
      my $no0_client = -1;
      my $no0_server = -1;
      Sys::Socket::Util->inet_socketpair(\$no0_client, \$no0_server, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);

      unless ($no0_client > 0 && $no0_server > 0) {
        return 0;
      }
      
      Sys::Socket::Util->set_blocking($no0_client, 0);
      Sys::Socket::Util->set_blocking($no0_server, 0);

      Fn->defer([$no0_client : int, $no0_server : int] method :void () {
        Sys::Socket->close($no0_client);
        Sys::Socket->close($no0_server);
      });

      # Pair 1
      my $no1_client = -1;
      my $no1_server = -1;
      Sys::Socket::Util->inet_socketpair(\$no1_client, \$no1_server, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);

      unless ($no1_client > 0 && $no1_server > 0) {
        return 0;
      }
      
      Sys::Socket::Util->set_blocking($no1_client, 0);
      Sys::Socket::Util->set_blocking($no1_server, 0);

      Fn->defer([$no1_client : int, $no1_server : int] method :void () {
        Sys::Socket->close($no1_client);
        Sys::Socket->close($no1_server);
      });
      
      {
        my $writefds = Sys::Select::Fd_set->new;
        
        Sys::Select->FD_SET($no0_client, $writefds);
        Sys::Select->FD_SET($no1_client, $writefds);
        
        my $socket_max = 0;
        if ($no0_client > $no1_client) {
          $socket_max = $no0_client;
        }
        else {
          $socket_max = $no1_client;
        }
        
        my $timeout = 10;
        
        my $ready_count_out = Sys->select(undef, $writefds, undef, $timeout);
        
        unless ($ready_count_out == 2) {
          return 0;
        }
        
        unless (Sys::Select->FD_ISSET($no0_client, $writefds)) {
          return 0;
        }
        unless (Sys::Select->FD_ISSET($no1_client, $writefds)) {
          return 0;
        }
      }
      
      {
        my $no0_send_buffer = "abcd";
        
        my $no0_send_length = Sys::Socket->send($no0_client, $no0_send_buffer, length $no0_send_buffer, 0);
        
        unless ($no0_send_length == 4) {
          return 0;
        }
      }
      
      {
        my $no0_send_buffer = "ef";
        
        my $no0_send_length = Sys::Socket->send($no0_client, $no0_send_buffer, length $no0_send_buffer, 0);
        
        unless ($no0_send_length == 2) {
          return 0;
        }
      }
      
      my $no0_status_shutdown = Sys::Socket->shutdown($no0_client, SOCKET->SHUT_WR);
      
      unless ($no0_status_shutdown == 0) {
        return 0;
      }

      {
        my $no1_send_buffer = "abcd";
        
        my $no1_send_length = Sys::Socket->send($no1_client, $no1_send_buffer, length $no1_send_buffer, 0);
        
        unless ($no1_send_length == 4) {
          return 0;
        }
      }
      
      {
        my $no1_send_buffer = "ef";
        
        my $no1_send_length = Sys::Socket->send($no1_client, $no1_send_buffer, length $no1_send_buffer, 0);
        
        unless ($no1_send_length == 2) {
          return 0;
        }
      }
      
      my $no1_status_shutdown = Sys::Socket->shutdown($no1_client, SOCKET->SHUT_WR);
      
      unless ($no1_status_shutdown == 0) {
        return 0;
      }
      
      # Wait
      Sys::Process->sleep(1);
      
      {
        my $readfds = Sys::Select::Fd_set->new;
        
        Sys::Select->FD_SET($no0_server, $readfds);
        Sys::Select->FD_SET($no1_server, $readfds);
        
        my $socket_max = 0;
        if ($no0_server > $no1_server) {
          $socket_max = $no0_server;
        }
        else {
          $socket_max = $no1_server;
        }
        
        my $timeout = 10;
        
        my $ready_count_in = Sys->select($readfds, undef, undef, $timeout);
        
        unless ($ready_count_in == 2) {
          return 0;
        }
        
        unless (Sys::Select->FD_ISSET($no0_server, $readfds)) {
          return 0;
        }
        unless (Sys::Select->FD_ISSET($no1_server, $readfds)) {
          return 0;
        }
      }
      
      {
        my $no0_recv_buffer = (mutable string)new_string_len 3;
        my $no0_recv_length = Sys::Socket->recv($no0_server, $no0_recv_buffer, length $no0_recv_buffer, 0);
        
        unless ($no0_recv_length == 3) {
          return 0;
        }
        
        unless ($no0_recv_buffer eq "abc") {
          return 0;
        }
      }
      
      {
        my $no0_recv_buffer = (mutable string)new_string_len 3;
        my $no0_recv_length = Sys::Socket->recv($no0_server, $no0_recv_buffer, length $no0_recv_buffer, 0);
        
        unless ($no0_recv_length == 3) {
          return 0;
        }
        
        unless ($no0_recv_buffer eq "def") {
          return 0;
        }
      }

      {
        my $no0_recv_buffer = (mutable string)new_string_len 3;
        my $no0_recv_length = Sys::Socket->recv($no0_server, $no0_recv_buffer, length $no0_recv_buffer, 0);
        
        unless ($no0_recv_length == 0) {
          return 0;
        }
      }
      
      {
        my $no1_recv_buffer = (mutable string)new_string_len 3;
        my $no1_recv_length = Sys::Socket->recv($no1_server, $no1_recv_buffer, length $no1_recv_buffer, 0);
        
        unless ($no1_recv_length == 3) {
          return 0;
        }
        
        unless ($no1_recv_buffer eq "abc") {
          return 0;
        }
      }
      
      {
        my $no1_recv_buffer = (mutable string)new_string_len 3;
        my $no1_recv_length = Sys::Socket->recv($no1_server, $no1_recv_buffer, length $no1_recv_buffer, 0);
        
        unless ($no1_recv_length == 3) {
          return 0;
        }
        
        unless ($no1_recv_buffer eq "def") {
          return 0;
        }
      }

      {
        my $no1_recv_buffer = (mutable string)new_string_len 3;
        my $no1_recv_length = Sys::Socket->recv($no1_server, $no1_recv_buffer, length $no1_recv_buffer, 0);
        
        unless ($no1_recv_length == 0) {
          return 0;
        }
      }
    }
    
    return 1;
  }

  static method select_utils : int () {

    {
      my $set = Sys::Select::Fd_set->new;
      
      my $fd = 0;
      
      if (Sys::Select->FD_ISSET($fd, $set)) {
        return 0;
      }
      
      Sys::Select->FD_SET($fd, $set);
      
      unless (Sys::Select->FD_ISSET($fd, $set)) {
        return 0;
      }
      
      Sys::Select->FD_CLR($fd, $set);
      
      if (Sys::Select->FD_ISSET($fd, $set)) {
        return 0;
      }
    }

    {
      my $set = Sys::Select::Fd_set->new;
      my $fd = 2;
      
      if (Sys::Select->FD_ISSET($fd, $set)) {
        return 0;
      }
      
      Sys::Select->FD_SET($fd, $set);
      
      unless (Sys::Select->FD_ISSET($fd, $set)) {
        return 0;
      }
      
      Sys::Select->FD_CLR($fd, $set);
      
      if (Sys::Select->FD_ISSET($fd, $set)) {
        return 0;
      }
    }
    
    {
      my $set = Sys::Select::Fd_set->new;
      Sys::Select->FD_SET(0, $set);
      Sys::Select->FD_SET(1, $set);
      Sys::Select->FD_SET(2, $set);
      
      Sys::Select->FD_ZERO($set);
      
      if (Sys::Select->FD_ISSET(0, $set)) {
        return 0;
      }
      if (Sys::Select->FD_ISSET(1, $set)) {
        return 0;
      }
      if (Sys::Select->FD_ISSET(2, $set)) {
        return 0;
      }
    }
    
    {
      my $set = Sys::Select::Fd_set->new;
      Sys::Select->FD_SET(0, $set);
      Sys::Select->FD_SET(1, $set);
      Sys::Select->FD_SET(2, $set);
      
      my $set_clone = $set->clone;
      
      unless (Sys::Select->FD_ISSET(0, $set_clone)) {
        return 0;
      }
      unless (Sys::Select->FD_ISSET(1, $set_clone)) {
        return 0;
      }
      unless (Sys::Select->FD_ISSET(2, $set_clone)) {
        return 0;
      }
    }
    
    return 1;
  }
}
