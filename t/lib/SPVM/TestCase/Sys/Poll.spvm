class TestCase::Sys::Poll {
  use Sys::Poll::PollfdArray;
  use Sys::Poll::Constant as POLL;
  use Sys::Socket;
  use Sys::Socket::Constant as SOCKET;
  use Sys::Socket::Util;
  use Sys::Process;
  use Sys::Poll;

  use Fn;

  static method poll : int () {
    {
      # Pair 0
      my $no0_client = -1;
      my $no0_server = -1;
      Sys::Socket::Util->inet_socketpair(\$no0_client, \$no0_server, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);

      unless ($no0_client > 0 && $no0_server > 0) {
        return 0;
      }

      Sys::Socket::Util->set_blocking($no0_client, 0);
      Sys::Socket::Util->set_blocking($no0_server, 0);

      Fn->defer([$no0_client : int, $no0_server : int] method :void () {
        Sys::Socket->close($no0_client);
        Sys::Socket->close($no0_server);
      });

      # Pair 1
      my $no1_client = -1;
      my $no1_server = -1;
      Sys::Socket::Util->inet_socketpair(\$no1_client, \$no1_server, SOCKET->AF_INET, SOCKET->SOCK_STREAM, 0);

      unless ($no1_client > 0 && $no1_server > 0) {
        return 0;
      }

      Sys::Socket::Util->set_blocking($no1_client, 0);
      Sys::Socket::Util->set_blocking($no1_server, 0);

      Fn->defer([$no1_client : int, $no1_server : int] method :void () {
        Sys::Socket->close($no1_client);
        Sys::Socket->close($no1_server);
      });

      {
        my $fds_length = 2;
        my $fds = Sys::Poll::PollfdArray->new($fds_length);

        $fds->set_fd(0, $no0_client);
        $fds->set_events(0, (short)(POLL->POLLOUT));

        $fds->set_fd(1, $no1_client);
        $fds->set_events(1, (short)(POLL->POLLOUT));

        my $timeout = -1;

        my $ready_count_out = Sys::Poll->poll($fds, $fds->length, $timeout);

        unless ($ready_count_out == 2) {
          diag;
          return 0;
        }

        unless ($fds->revents(0) & POLL->POLLOUT) {
          diag;
          return 0;
        }

        unless ($fds->revents(1) & POLL->POLLOUT) {
          diag;
          return 0;
        }
      }

      {
        my $no0_send_buffer = "abcd";

        my $no0_send_length = Sys::Socket->send($no0_client, $no0_send_buffer, length $no0_send_buffer, 0);

        unless ($no0_send_length == 4) {
          return 0;
        }
      }

      {
        my $no0_send_buffer = "ef";

        my $no0_send_length = Sys::Socket->send($no0_client, $no0_send_buffer, length $no0_send_buffer, 0);

        unless ($no0_send_length == 2) {
          return 0;
        }
      }

      my $no0_status_shutdown = Sys::Socket->shutdown($no0_client, SOCKET->SHUT_WR);

      unless ($no0_status_shutdown == 0) {
        return 0;
      }

      {
        my $no1_send_buffer = "abcd";

        my $no1_send_length = Sys::Socket->send($no1_client, $no1_send_buffer, length $no1_send_buffer, 0);

        unless ($no1_send_length == 4) {
          return 0;
        }
      }

      {
        my $no1_send_buffer = "ef";

        my $no1_send_length = Sys::Socket->send($no1_client, $no1_send_buffer, length $no1_send_buffer, 0);

        unless ($no1_send_length == 2) {
          return 0;
        }
      }

      my $no1_status_shutdown = Sys::Socket->shutdown($no1_client, SOCKET->SHUT_WR);

      unless ($no1_status_shutdown == 0) {
        return 0;
      }

      # Wait
      Sys::Process->sleep(1);

      {
        my $fds = Sys::Poll::PollfdArray->new;

        $fds->push(0);
        $fds->push(1);

        $fds->set_fd(0, $no0_server);
        $fds->set_events(0, (short)(POLL->POLLIN));

        $fds->set_fd(1, $no1_server);
        $fds->set_events(1, (short)(POLL->POLLIN));

        my $timeout = -1;

        my $ready_count_in = Sys::Poll->poll($fds, $fds->length, $timeout);

        unless ($ready_count_in == 2) {
          return 0;
        }

        unless ($fds->revents(0) & POLL->POLLIN) {
          return 0;
        }

        unless ($fds->revents(1) & POLL->POLLIN) {
          return 0;
        }
      }

      {
        my $no0_recv_buffer = (mutable string)new_string_len 3;
        my $no0_recv_length = Sys::Socket->recv($no0_server, $no0_recv_buffer, length $no0_recv_buffer, 0);

        unless ($no0_recv_length == 3) {
          return 0;
        }

        unless ($no0_recv_buffer eq "abc") {
          return 0;
        }
      }

      {
        my $no0_recv_buffer = (mutable string)new_string_len 3;
        my $no0_recv_length = Sys::Socket->recv($no0_server, $no0_recv_buffer, length $no0_recv_buffer, 0);

        unless ($no0_recv_length == 3) {
          return 0;
        }

        unless ($no0_recv_buffer eq "def") {
          return 0;
        }
      }

      {
        my $no0_recv_buffer = (mutable string)new_string_len 3;
        my $no0_recv_length = Sys::Socket->recv($no0_server, $no0_recv_buffer, length $no0_recv_buffer, 0);

        unless ($no0_recv_length == 0) {
          return 0;
        }
      }

      {
        my $no1_recv_buffer = (mutable string)new_string_len 3;
        my $no1_recv_length = Sys::Socket->recv($no1_server, $no1_recv_buffer, length $no1_recv_buffer, 0);

        unless ($no1_recv_length == 3) {
          return 0;
        }

        unless ($no1_recv_buffer eq "abc") {
          return 0;
        }
      }

      {
        my $no1_recv_buffer = (mutable string)new_string_len 3;
        my $no1_recv_length = Sys::Socket->recv($no1_server, $no1_recv_buffer, length $no1_recv_buffer, 0);

        unless ($no1_recv_length == 3) {
          return 0;
        }

        unless ($no1_recv_buffer eq "def") {
          return 0;
        }
      }

      {
        my $no1_recv_buffer = (mutable string)new_string_len 3;
        my $no1_recv_length = Sys::Socket->recv($no1_server, $no1_recv_buffer, length $no1_recv_buffer, 0);

        unless ($no1_recv_length == 0) {
          return 0;
        }
      }

      {
        my $fds = Sys::Poll::PollfdArray->new(0);
      }
    }
    
    return 1;
  }
}
